# ─────────────────────────────────────────────────────────────────────────────
# ResQAI backend configuration. Copy to `backend/.env` and fill in.
# NEVER commit a real .env. These values stay server-side only.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI voice provider: Google Gemini Multimodal Live ──
# Free key (no card): https://aistudio.google.com/apikey
# Leave EMPTY to run the backend with voice DISABLED — REST APIs still work and
# /api/status will report hasApiKey:false (the UI degrades honestly).
GEMINI_API_KEY=

# Optional. Empty => Pipecat's current default live model (recommended).
GEMINI_LIVE_MODEL=
# Gemini Live voice name (Puck, Charon, Kore, Fenrir, Aoede, ...).
GEMINI_VOICE=Puck

# ── Server ──
HOST=0.0.0.0
PORT=8001
# Comma-separated origins allowed to call the API / open WebRTC (Vite dev server).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Auth / sessions ──
# OTP delivery is still a DEMO (no SMS sent; fixed code). The SESSION, however, is
# real: verify-otp issues an HMAC-signed bearer token. Set a strong random secret
# in production (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# If empty, an ephemeral per-process secret is used (dev only; tokens die on restart).
DEMO_OTP_CODE=123456
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800

# ── Database ──
DATABASE_URL=sqlite:///./resqai.db

# ─────────────────────────────────────────────────────────────────────────────
# SMS emergency alerting (contacts receive an SMS when the user triggers SOS)
# ─────────────────────────────────────────────────────────────────────────────
# Channel/provider:
#   mock   — dev/tests, sends nothing
#   email  — FREE, no DLT: sends the alert by email via SMTP (recommended free path)
#   msg91  — real India SMS (requires a paid MSG91 account + DLT registration)
SMS_PROVIDER=mock

# ── Email channel (SMS_PROVIDER=email) — entirely free, no DLT ──
# Works with ANY SMTP server. Two easy free options:
#   A) Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
#      SMTP_PASSWORD=<16-char App Password> (Google Account → Security → 2-Step
#      Verification → App passwords). SMTP_FROM must be your Gmail address.
#   B) Brevo (free 300/day, delivery webhooks): SMTP_HOST=smtp-relay.brevo.com,
#      SMTP_PORT=587, SMTP_USERNAME=<brevo login>, SMTP_PASSWORD=<brevo SMTP key>,
#      SMTP_FROM=<your verified sender>. Point Brevo's event webhook at
#      {SMS_CALLBACK_URL}?secret={SMS_CALLBACK_SECRET} to get real delivered/bounce
#      receipts (otherwise sends are recorded as 'provider_accepted', not delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=ResQAI Alerts
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ── MSG91 v5 Flow API (only used when SMS_PROVIDER=msg91) ──
# Dashboard: https://control.msg91.com  |  DLT guide:
# https://msg91.com/help/dlt-registration-in-india/step-by-step-guide-to-implement-dlt-in-sms/
# These are SERVER-ONLY secrets. Never expose them in the frontend.
MSG91_AUTH_KEY=
# The DLT-approved Flow/template id (MSG91's v5 API calls this flow_id).
MSG91_TEMPLATE_ID=
# The approved 6-char DLT sender/header id, e.g. RESQAI.
MSG91_SENDER_ID=
# Optional DLT Principal Entity id (for your records / config validation).
MSG91_DLT_ENTITY_ID=
# Base URL (leave default unless using a staging/proxy host).
MSG91_BASE_URL=https://api.msg91.com

# ── SMS delivery behaviour ──
# Per-send HTTP timeout to the provider (ms). A send must not hang a worker.
SMS_PROVIDER_TIMEOUT_MS=8000
# Max send attempts per recipient before dead-lettering to FAILED.
SMS_MAX_ATTEMPTS=4
# Base delay for exponential backoff between retries (ms).
SMS_RETRY_BASE_DELAY_MS=2000
# How often the background worker polls the outbox for due jobs (ms).
SMS_WORKER_POLL_MS=1000
# Start the background notification worker at boot (tests set this false).
SMS_WORKER_AUTOSTART=true
# Brand/header shown in the SMS body — MUST match your approved DLT template.
SMS_BRAND_NAME=RESQAI

# ── Delivery-report (DLR) callback ──
# MSG91 SMS delivery reports are NOT HMAC-signed, so we authenticate the webhook
# with a shared secret presented in the callback URL and compared in constant
# time. REQUIRED for real sending — empty means callbacks are REJECTED.
# Configure MSG91 to POST to:  {SMS_CALLBACK_URL}?secret={SMS_CALLBACK_SECRET}
SMS_CALLBACK_SECRET=
# The public URL MSG91 should call back to (documentation / ops reference).
SMS_CALLBACK_URL=https://your-backend.example.com/api/sms/callback

# ── Abuse limits ──
MAX_CONTACTS_PER_USER=10
SOS_RATE_LIMIT=5
SOS_RATE_WINDOW_SECONDS=300
CONTACTS_RATE_LIMIT=60
CONTACTS_RATE_WINDOW_SECONDS=60

# ── Session guardrails (cost / abuse control) ──
MAX_SESSION_SECONDS=300
MAX_CONCURRENT_SESSIONS=3

# ── Live retrieval (weather, nearby hospitals, advisories) ──
# The agent retrieves time-sensitive facts through tools instead of guessing.
# Default sources are FREE and need NO API key:
#   * Weather + weather hazards : Open-Meteo        (api.open-meteo.com)
#   * Nearby hospitals          : OpenStreetMap     (Overpass API mirrors)
#   * Emergency helpline numbers : built-in official India reference (not a feed)
ENABLE_RETRIEVAL=true
# Jurisdiction for official helpline reference data (currently only IN is vetted).
DEFAULT_COUNTRY=IN
# Hard per-request timeout (seconds). Keep tight — a voice turn must not stall.
RETRIEVAL_TIMEOUT_SECONDS=6
# OSM/Nominatim/Overpass policy REQUIRES an identifying User-Agent. Put a real
# contact/URL here for production use.
RETRIEVAL_USER_AGENT=ResQAI-Emergency-Assistant/1.0 (+https://github.com/; emergency-demo)
# Cache freshness windows (seconds). Short, because emergency facts move fast.
WEATHER_CACHE_SECONDS=600
HOSPITALS_CACHE_SECONDS=1800
ADVISORY_CACHE_SECONDS=120
# Overpass mirrors (comma-separated). First that answers wins; all are flaky, so
# on failure the agent degrades honestly ("couldn't fetch — dial 108/112").
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# OPTIONAL official disaster-advisory feed (CAP/GeoRSS/JSON), called as
# `<url>?lat=..&lng=..`. No free, stable, credential-free India-wide feed exists,
# so this is EMPTY by default and the advisory tool then honestly reports
# "no live feed configured" instead of fabricating alerts.
# To wire a real one you must provide an endpoint you are authorised to use, e.g.
# an NDMA Sachet / IMD proxy you host. Document and secure any credentials there.
DISASTER_ADVISORY_URL=

# ── Privacy / logging ──
# Keep false unless you have a disclosed reason to retain transcripts.
STORE_TRANSCRIPTS=false
LOG_LEVEL=INFO

# ── Hosted Tough Tongue AI voice agent (optional) ──
# If set, GET /api/resqai/config serves this URL to the frontend widget at
# runtime (no-store), so you can rotate the hosted embed without rebuilding the
# frontend. Leave empty to let the frontend use its own VITE_RESQAI_* config.
# A token-bearing embed URL is a bearer credential — never commit a real .env.
RESQAI_AGENT_URL=
