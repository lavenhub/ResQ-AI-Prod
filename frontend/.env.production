# Production build-time config (VITE_* values are PUBLIC — baked into the bundle).
# Used by `vite build` (web production build AND the Capacitor APK build) so the
# app targets the deployed backend. `vite dev` ignores this file and uses the
# local proxy instead. On Vercel, a VITE_API_URL env var (if set) takes
# precedence over this file.

# The public backend the app talks to.
VITE_API_URL=https://resqai-backend-6afi.onrender.com

# The public web app URL, used to build shareable links (e.g. the ambulance
# reception link). Inside a Capacitor APK window.location.origin is "localhost",
# so this is needed for the reception link to be a real shareable URL.
VITE_PUBLIC_WEB_URL=https://resq-ai-prod-two.vercel.app
