# Copy this to .env.local (gitignored) and fill in. Restart `vite dev` after changes.

# Backend URL for the Python API / WebRTC dispatcher (optional in local dev —
# Vite proxies /api and /health to http://localhost:8001 when this is empty).
VITE_API_URL=https://your-backend.onrender.com

# ── Hosted Tough Tongue AI voice agent (Emergency screen) ───────────────────
# The widget works out of the box using the public demo scenario id baked into
# the component, so both of these are OPTIONAL. Set them to point at your own /
# a private scenario instead.
#
# Full hosted embed URL. Use this for private or passcode/token scenarios.
# A token-bearing URL is a bearer credential — keep it here (gitignored), keep
# it short-lived, and NEVER commit it.
VITE_RESQAI_AGENT_URL=

# OR just the scenario id — the widget builds the documented embed URL:
#   https://app.toughtongueai.com/embed/<id>?bg=black&skipPrecheck=true
VITE_RESQAI_SCENARIO_ID=
